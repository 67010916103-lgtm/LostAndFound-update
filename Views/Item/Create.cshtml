@model LostAndFound.Models.Item

@{
    ViewData["Title"] = "แจ้งพบของ / แจ้งของหาย";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        background: #ffffff;
    }

    .header-gradient {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border-radius: 15px 15px 0 0;
        padding: 20px;
    }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-gradient-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(28, 200, 138, 0.4);
            color: white;
        }
</style>

<div class="container my-5" style="max-width: 650px;">
    <div class="card card-custom">
        <div class="header-gradient text-center">
            <h3 class="mb-0 fw-bold"><i class="bi bi-megaphone-fill me-2"></i>แจ้งพบของ / แจ้งของหาย</h3>
            <small class="opacity-75">กรอกข้อมูลเพื่อลงประกาศในระบบ</small>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data" method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">ชื่อสิ่งของ</label>
                    <input asp-for="Title" class="form-control form-control-lg shadow-sm" placeholder="เช่น กระเป๋าสตางค์, กุญแจรถ, หูฟัง" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Type" class="form-label fw-semibold">ประเภทประกาศ</label>
                        <select asp-for="Type" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<LostAndFound.Models.ItemType>()"></select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">หมวดหมู่</label>
                        <select asp-for="CategoryId" class="form-select shadow-sm" asp-items="ViewBag.CategoryId">
                            <option value="">-- เลือกหมวดหมู่ --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-semibold">สถานที่พบ/ทำหาย (มมส)</label>
                    <select asp-for="Location" class="form-select shadow-sm">
                        <option value="">-- เลือกสถานที่ใน มมส --</option>
                        <option value="สนามฟ้า">สนามฟ้า (ลานกิจกรรมกลาง)</option>
                        <option value="อาคารเรียนรวมราชนครินทร์ (RN)">อาคารเรียนรวมราชนครินทร์ (RN)</option>
                        <option value="สำนักวิทยบริการ (หอสมุดกลาง)">สำนักวิทยบริการ (หอสมุดกลาง)</option>
                        <option value="ศูนย์อาหารกลาง (โรงอาหาร มมส)">ศูนย์อาหารกลาง (โรงอาหาร มมส)</option>
                        <option value="อาคารบริการนิสิต (ตลาดน้อย)">อาคารบริการนิสิต (ตลาดน้อย)</option>
                        <option value="คณะวิทยาการสารสนเทศ">คณะวิทยาการสารสนเทศ</option>
                        <option value="คณะบัญชีและการจัดการ">คณะบัญชีและการจัดการ</option>
                        <option value="คณะมนุษยศาสตร์และสังคมศาสตร์">คณะมนุษยศาสตร์และสังคมศาสตร์</option>
                        <option value="คณะวิศวกรรมศาสตร์">คณะวิศวกรรมศาสตร์</option>
                        <option value="อาคารพลศึกษา / สนามกีฬา">อาคารพลศึกษา / สนามกีฬา</option>
                        <option value="ป้ายรถรับส่ง / ลานจอดรถ">ป้ายรถรับส่ง / ลานจอดรถ</option>
                        <option value="หอพักในกำกับมหาวิทยาลัย">หอพักในกำกับมหาวิทยาลัย</option>
                        <option value="อื่นๆ">อื่นๆ</option>
                    </select>
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">รายละเอียดเพิ่มเติม</label>
                    <textarea asp-for="Description" class="form-control shadow-sm" rows="3" placeholder="ระบุสี ลักษณะจุดสังเกต หรือข้อมูลเพิ่มเติม..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ReporterType" class="form-label fw-semibold">สถานะผู้แจ้ง</label>
                    <select asp-for="ReporterType" class="form-select shadow-sm" asp-items="Html.GetEnumSelectList<LostAndFound.Models.ReporterType>()"></select>
                    <span asp-validation-for="ReporterType" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StudentId" class="form-label fw-semibold">รหัสนิสิต / รหัสบุคลากร (ถ้ามี)</label>
                        <input asp-for="StudentId" class="form-control shadow-sm" placeholder="เช่น 6701096079" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">เบอร์โทรศัพท์ / Line ID <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control shadow-sm" placeholder="เช่น 081-2345678 หรือ Line ID" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-semibold">วันที่และเวลาที่เกิดเหตุ</label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control shadow-sm" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">อัปโหลดรูปภาพ</label>
                    <input type="file" name="imageFile" class="form-control shadow-sm" accept="image/*" />
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                        ยกเลิก
                    </a>
                    <button type="submit" class="btn btn-gradient-primary px-5 rounded-pill fw-bold">
                        บันทึกข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>